# Copy only the values you need into the existing project .env file.
# Do not commit real passwords, tokens, or API keys.

STOCK_APP_API_PORT=8010
STOCK_APP_WEB_PORT=8501
STOCK_AGENT_MAX_CONCURRENT_TASKS=4
STOCK_AGENT_API_TIMEOUT_SECONDS=600

# External services running on the Windows host.
NEO4J_URI=bolt://host.docker.internal:7687
STOCK_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Paths inside the API container. Host project data/models are mounted to /app.
QLIB_PROVIDER_URI=/app/data/qlib
DFT_UNET_CHECKPOINT_PATH=/app/models/dft_unet/latest/model.pth

# CPU-only PyTorch is the default image build. Override only when maintaining
# a compatible CUDA base image and NVIDIA Container Toolkit configuration.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
